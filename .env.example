# MongoDB Atlas 연결 문자열
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 사용할 데이터베이스 이름 (선택, 기본값 linknamu)
MONGODB_DB=linknamu
# 세션 서명용 비밀키 (32자 이상 무작위 문자열)
AUTH_SECRET=change-me-to-a-long-random-string-32chars-or-more
# 사이트 주소 (선택, SNS 공유 미리보기 이미지 주소에 사용. Vercel에서는 자동 감지)
NEXT_PUBLIC_SITE_URL=
